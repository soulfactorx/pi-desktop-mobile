  "pi": {
    "extensions": [
      "./extensions/agent-core/index.ts",
      "./extensions/permissions/index.ts",
      "./extensions/loop-guard/index.ts",
      "./extensions/local-model/index.ts",
      "./extensions/ask-user/index.ts",
      "./extensions/web/index.ts",
      "./extensions/memory/index.ts",
      "./extensions/documents/index.ts",
      "./extensions/tasks/index.ts",
      "./extensions/schedule/index.ts",
      "./extensions/elevation/index.ts",
      "./extensions/peers/index.ts",
      "./extensions/skills/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@pi-desktop/pi-isolation": "*",
    "@pi-desktop/pi-resources": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@pi-desktop/host-protocol": "*"
