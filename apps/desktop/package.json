{
  "name": "@pi-desktop/desktop",
  "productName": "Pi Desktop",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pi Desktop Electron 앱",
  "author": "skax-soulfactor",
  "homepage": "https://github.com/skax-soulfactor/pi-desktop",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "npm run build -w @pi-desktop/host-agent",
    "dev": "electron-vite dev",
    "dev:mock": "node scripts/dev-mock.mjs",
    "dev:web": "node scripts/dev-mock.mjs --web",
    "build": "electron-vite build",
    "build:web": "npm run build -w @pi-desktop/host-agent && npm run build -w @pi-desktop/mate-runner && node scripts/build-web.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run build -w @pi-desktop/host-agent && electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "dist:web": "npm run build -w @pi-desktop/host-agent && npm run build -w @pi-desktop/mate-runner && node scripts/build-web.mjs --pack"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@pi-desktop/host-protocol": "*",
    "@pi-desktop/web-shell": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "vite": "^8.3.4",
    "ws": "^8.22.0"
  }
}
